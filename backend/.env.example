# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- App ---
APP_NAME=capture-system-backend
ENVIRONMENT=development
DEBUG=true

# --- Database (Supabase Postgres, async driver) ---
# Get the connection string from Supabase Dashboard > Project Settings >
# Database > Connection string (URI), then change "postgresql://" to
# "postgresql+asyncpg://".
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Supabase ---
# SUPABASE_KEY must be the service_role key (server-side only). Never ship
# it to the Android app or any client.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_BUCKET=traffic-sign-temp

# --- Local cache (images downloaded by the worker before AI processing) ---
LOCAL_CACHE=./cache

# --- AI ---
YOLO_MODEL=yolov8n.pt

# --- Background worker ---
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=1
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=2

# --- Uploads ---
MAX_UPLOAD_SIZE_BYTES=15728640

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
